# Node >=24. Local video validation also requires ffprobe (brew install ffmpeg).
PORT=8787
AI_PROVIDER=mock
BILLING_ENABLED=false
# Production must use sightengine or illuminarty + BILLING_ENABLED=true. GPTZero powers text.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# AI_PROVIDER=illuminarty: images only, no video support.
ILLUMINARTY_API_KEY=
GPTZERO_API_KEY=
# Durable SQLite, one backend process per DB. Docker volume is already configured.
BILLING_DB_PATH=./data/billing.sqlite
# Sandbox and Production MUST have separate databases/deployments.
APPLE_ENVIRONMENT=Sandbox
APPLE_BUNDLE_ID=com.kukjinman.aidetector.app
APPLE_APP_ID=
# Comma-separated local DER certificate paths downloaded from Apple PKI.
APPLE_ROOT_CA_PATHS=
# Example Docker path: /app/certs/AppleRootCA-G3.cer
# Legal values are plain text and HTML escaped. Fill with actual verified facts.
LEGAL_OPERATOR=
LEGAL_REPRESENTATIVE=
LEGAL_ADDRESS=
LEGAL_BUSINESS_NUMBER=
LEGAL_COMMERCE_NUMBER=
SUPPORT_EMAIL=
LEGAL_PRIVACY_OFFICER=
LEGAL_EFFECTIVE_DATE=
# Include legal names, roles and hosting vendor, including processing location.
LEGAL_PROCESSORS=
# Recipient/contact, countries, data, purpose, timing/method, retention,
# legal basis, how to refuse and consequences. Confirm each provider's contract.
LEGAL_OVERSEAS_TRANSFER=
# Exact retention/legal grounds for wallet, transactions, requests, logs, backups.
LEGAL_RETENTION=

# Explicit local-only real API testing without Apple setup. Requires NODE_ENV=development.
# Never enable on a public server. API calls still incur provider charges.
ALLOW_UNBILLED_LOCAL_API=false
